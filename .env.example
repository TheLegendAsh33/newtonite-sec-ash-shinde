# Copy to .env and replace every CHANGE_ME value before starting the stack.
POSTGRES_DB=newtonite
POSTGRES_USER=newtonite
POSTGRES_PASSWORD=CHANGE_ME_USE_A_RANDOM_URL_SAFE_VALUE
REDIS_PASSWORD=CHANGE_ME_USE_ANOTHER_RANDOM_URL_SAFE_VALUE
SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS

# Use :8080 for local HTTP. For production, set your public DNS name (for example, work.example.com)
# and point its A/AAAA records at this host so Caddy can provision TLS.
PUBLIC_HOST=:8080

# Keep false only for local HTTP. Set true behind Caddy TLS in production.
COOKIE_HTTPS_ONLY=false

# Optional additional browser origins, comma-separated. Leave empty for the same-origin Caddy setup.
CORS_ORIGINS=
