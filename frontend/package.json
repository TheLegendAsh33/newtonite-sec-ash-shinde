{
  "name": "newtonite-workbench",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "e2e:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/e2e-local.ps1",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:down": "docker compose --project-name newtonite-e2e --file ../docker-compose.e2e.yml down --volumes --remove-orphans"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
